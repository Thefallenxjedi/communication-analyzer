# Shared default Gemini key (also set on Vercel)
GOOGLE_GENERATIVE_AI_API_KEY=

# Soft per-IP daily limits (separate buckets for audio vs YouTube)
ANALYZE_DAILY_AUDIO_LIMIT=10
ANALYZE_DAILY_YOUTUBE_LIMIT=5
# Legacy combined cap (unused when audio/youtube limits are set)
# ANALYZE_DAILY_LIMIT=20

# Optional model override (default: gemini-3.5-flash-lite for cost)
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.5-flash-lite
# Quality upgrade: gemini-3.6-flash

# Diagnosis page CTA (all result CTAs → diagnosis call)
# NEXT_PUBLIC_DIAGNOSIS_CALL_URL=https://www.elitespeakprogram.com/elitespeak-video16#open-popup

# MongoDB Atlas (legacy — prefer Convex)
# MONGODB_URI=

# Password for /admin (view analyses: id, score, speak time)
ADMIN_PASSWORD=

# Convex (anonymous attempts + scores)
# Dev: from `npx convex dev` → NEXT_PUBLIC_CONVEX_URL in .env.local
# Prod (Vercel): https://blissful-rabbit-594.convex.cloud
NEXT_PUBLIC_CONVEX_URL=
# Optional server-only alias (same value as above)
# CONVEX_URL=

# Kartra inbound API (server-only — never expose to the browser)
KARTRA_APP_ID=
KARTRA_API_KEY=
KARTRA_API_PASSWORD=
# Exact list name from Kartra → Communication → Lists
KARTRA_LIST_NAME=
# Optional: override custom field identifiers (defaults shown)
# KARTRA_FIELD_OVERALL_SCORE=overall_score
# KARTRA_FIELD_LEVEL=level
# KARTRA_FIELD_MAIN_FOCUS=main_focus
# KARTRA_FIELD_WHAT_WENT_WELL=what_went_well
# KARTRA_FIELD_WHAT_TO_IMPROVE=what_to_improve
# Unique report URL (https://app.elitespeakprogram.com/r/…) — create this text field in Kartra
# KARTRA_FIELD_REPORT_LINK=assessment_link
# Optional score-band tags (score_low / score_mid / score_high) — create tags in Kartra first
# KARTRA_ASSIGN_SCORE_TAGS=true

# YouTube transcript — public youtube-transcript.ai; no API key required.
# Optional override if the host changes:
# YOUTUBE_TRANSCRIPT_AI_BASE=https://youtube-transcript.ai/transcript

# YouTube full analysis — RapidAPI "YouTube MP3" (server-only; set on Vercel)
RAPIDAPI_KEY=
# Optional override if the host changes:
# RAPIDAPI_YOUTUBE_HOST=youtube-mp310.p.rapidapi.com

# Optional Gemini $ / 1M tokens for admin cost estimates
# Defaults: 3.6 Flash intro 0.75/3.75, 3.5 Flash-Lite 0.30/2.50
# GEMINI_FLASH_INPUT_PER_MILLION=0.75
# GEMINI_FLASH_OUTPUT_PER_MILLION=3.75
# GEMINI_LITE_INPUT_PER_MILLION=0.30
# GEMINI_LITE_OUTPUT_PER_MILLION=2.50
